## Server environment example
# Copy this to `.env` and fill values before running the server.

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=portfolio_cms

# JWT
JWT_SECRET=change_this_random_secret

# Cloudinary (if used)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email / SMTP (required to send contact form notifications)
# For Gmail: use smtp.gmail.com and an App Password (enable 2FA, create an app password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your@email.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM="Portfolio CMS <your@email.com>"
EMAIL_TO=you@receive.com

# Example: EMAIL_USER=me@gmail.com
#          EMAIL_PASSWORD=abcd efgh ijkl (no spaces normally)

